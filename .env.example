# Application to deploy: "isaac-sim" or "isaac-lab"
# APP=isaac-sim

# OpenShift cluster apps domain (e.g., apps.mycluster.p1.openshiftapps.com)
CLUSTER_DOMAIN=

# Namespace for the deployment
NAMESPACE=isaac-sim-streaming

# NGC API key for pulling nvcr.io/nvidia/isaac-sim images
# Get one at https://ngc.nvidia.com/setup
NGC_API_KEY=

# Container image for the web client (built with `make build-client`)
CLIENT_IMAGE=quay.io/youruser/isaac-sim-client:latest

# TURN relay password (leave empty to auto-generate during deploy)
COTURN_PASSWORD=

# GPU product label from NFD/GFD (check with `make gpu-info`)
GPU_PRODUCT=NVIDIA-L40S

# GPU runtime class name (usually "nvidia" with GPU Operator)
GPU_RUNTIME_CLASS=nvidia

# Stream resolution and framerate
# STREAM_WIDTH=1920
# STREAM_HEIGHT=1080
# STREAM_FPS=30

# Isaac Lab: script filename (must exist in scripts/ directory)
# ISAAC_LAB_SCRIPT=demo_lab.py

